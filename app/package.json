{
	"name": "app",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#config/*": "./src/config/*",
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint . --deny-warnings",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"test:unit": "vitest",
		"test": "vitest run",
		"i18n:compile": "paraglide-js compile --project ./project.inlang",
		"create-api": "bun scripts/create-api.ts",
		"create-api:admin": "bun run create-api admin"
	},
	"dependencies": {
		"@tanstack/svelte-query": "^6.4.1",
		"mode-watcher": "^1.1.0"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/paraglide-js": "^3.2.1",
		"@lucide/svelte": "^1.70.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/svelte-query-devtools": "^6.4.1",
		"@vitest/browser-playwright": "^5.1.0",
		"cn": "^0.5.2",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"playwright": "^1.65.0",
		"shadcn-svelte": "^1.8.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-variants": "^4.0.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-svelte-plugin": "^0.3.52",
		"vite": "^8.3.7",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"overrides": {
		"postcss-selector-parser": "6.1.5"
	}
}
