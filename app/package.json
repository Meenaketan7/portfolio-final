{
	"name": "app",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint . --deny-warnings",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"i18n:compile": "paraglide-js compile --project ./project.inlang"
	},
	"dependencies": {
		"mode-watcher": "^1.1.0"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@lucide/svelte": "^1.48.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@vitest/browser-playwright": "^4.1.8",
		"cn": "^0.3.0",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"playwright": "^1.60.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-svelte-plugin": "^0.3.52",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	}
}
